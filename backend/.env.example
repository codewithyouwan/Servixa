# Copy to .env and fill in real values. See docs/architecture/08-aws-mvp-setup-guide.md
# and docs/architecture/09-aws-console-decisions-log.md for where these come from.

# --- Database (RDS Postgres) ---
DATABASE_URL=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- AWS / Cognito ---
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Groq (marketplace_agent AI conversational agent) ---
# Get a key at https://console.groq.com
GROQ_API_KEY=

# --- Blog (S3 image uploads) ---
BLOG_MEDIA_BUCKET=
SITE_URL=https://bestbuild.ai
