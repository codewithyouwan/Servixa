# Local development environment
POSTGRES_USER=bestbuild
POSTGRES_DB=bestbuild
DB_PASSWORD=dev-password

# Backend
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
DATABASE_URL=postgresql://bestbuild:dev-password@db:5432/bestbuild
REDIS_URL=redis://redis:6379
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=

# AWS Cognito (see docs/architecture/08-aws-mvp-setup-guide.md) — leave
# blank for local dev unless you have a real user pool; register/login
# will fail without them, but the rest of the API works fine.
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Frontend
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production override example
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# JWT_SECRET=replace-with-a-long-random-secret
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# REDIS_URL=redis://host:6379
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
