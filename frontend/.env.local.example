# API mode: "mock" (in-memory fixtures, default) | "live" (FastAPI backend)
NEXT_PUBLIC_API_MODE=mock

# FastAPI origin, used only when NEXT_PUBLIC_API_MODE=live
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mock session role: "homeowner" (default) | "service_provider"
# No role-based login yet — flip this to preview the Contractor CRM.
NEXT_PUBLIC_MOCK_ROLE=service_provider
