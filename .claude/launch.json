{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "servixa-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 3000
    },
    {
      "name": "servixa-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "app.main:app", "--reload", "--port", "8000"],
      "cwd": "bestbuild-api",
      "port": 8000
    }
  ]
}
