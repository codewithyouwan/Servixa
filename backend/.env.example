# Copy to .env for local dev: `cp .env.example .env`. Never commit the
# real .env — it's already covered by the repo's .gitignore pattern for
# env files, double check before your first commit.

# --- Database (db/database.py) ---
# Local Postgres by default; point this at the RDS endpoint from
# docs/architecture/08-aws-mvp-setup-guide.md §4 for staging/prod.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mydb

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- AWS Cognito (see docs/architecture/08-aws-mvp-setup-guide.md) ---
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_SECRET=

# --- AWS credentials for boto3's Cognito admin calls ---
# Local dev: run `aws configure` once instead of setting these here.
# Lambda: not needed — the function's IAM execution role provides them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Groq (marketplace_agent AI conversational agent) ---
# Get a key at https://console.groq.com
GROQ_API_KEY=
